# Arrays are cached so re-runs are instant.
# ==============================================================================

def fetch_plantvillage(root, per_other):
    # sparse, blob-less clone: downloads only the chosen image files (all tomato + per_other per other class)
    print('Downloading PlantVillage images from GitHub (one-time, a few minutes)...')
    url = 'https://github.com/spMohanty/PlantVillage-Dataset.git'
    if not os.path.isdir(root):
        subprocess.run(['git', 'clone', '-q', '--depth', '1', '--filter=blob:none', '--no-checkout', url, root], check=True)
    files = subprocess.run(['git', '-C', root, 'ls-tree', '-r', '--name-only', 'HEAD', 'raw/grayscale'],
                           capture_output=True, text=True, check=True).stdout.splitlines()
    by_cls = {}
    for f in files: by_cls.setdefault(f.split('/')[2], []).append(f)
    pick = [f for c, fs in sorted(by_cls.items())
            for f in (fs if c.lower().startswith('tomato') else sorted(fs)[:per_other])]
    pats = '\n'.join('/' + re.sub(r'([\[\]*?\\!#])', r'\\\1', f) for f in pick)
    subprocess.run(['git', '-C', root, 'sparse-checkout', 'set', '--no-cone', '--stdin'], input=pats, text=True, check=True)
    subprocess.run(['git', '-C', root, 'checkout', '-q', 'HEAD'], check=True)
    return os.path.join(root, 'raw', 'grayscale')

def load_folder(root):
    from PIL import Image
    names = sorted(d for d in os.listdir(root) if os.path.isdir(os.path.join(root, d)))
    Xs, ys = [], []
    for i, n in enumerate(names):
        for f in sorted(os.listdir(os.path.join(root, n))):
            try:
                im = Image.open(os.path.join(root, n, f)).convert('L').resize((IMG, IMG))
                Xs.append(np.asarray(im, np.float32) / 255.0); ys.append(i)
            except Exception:
                pass
    return np.stack(Xs), np.array(ys), names

def make_synthetic(K, per):
    # smoke-test stand-in only (class = position of a dark blob on a bright leaf)
    yy, xx = np.mgrid[0:IMG, 0:IMG]
    Xs, ys = [], []
    for c in range(K):
        cy, cx = 12 + (c * 7) % 40, 12 + (c * 13) % 40
        for _ in range(per):
            img = 0.6 + 0.1 * rng.standard_normal() - 0.4 * np.exp(-((yy - cy - rng.normal(0, 3))**2 + (xx - cx - rng.normal(0, 3))**2) / 60)
            Xs.append(np.clip(img + 0.05 * rng.standard_normal((IMG, IMG)), 0, 1).astype(np.float32)); ys.append(c)
    return np.stack(Xs), np.array(ys), [f'Tomato___synthetic_{c}' for c in range(K)]

