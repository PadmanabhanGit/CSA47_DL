       \"dtype\": \"number\",\n        \"std\": 1.3618876605652903,\n        \"min\": 3.3219,\n        \"max\": 5.2479,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          5.2479,\n          3.3219\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"chance acc 1/K\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.05211376977344855,\n        \"min\": 0.0263,\n        \"max\": 0.1,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          0.0263,\n          0.1\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"majority acc\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.1899995921048253,\n        \"min\": 0.0263,\n        \"max\": 0.295,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          0.0263,\n          0.295\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["actual flipped fraction = 0.2058\n","With symmetric noise η=0.2 a perfect classifier scores only 0.8 accuracy on NOISY labels; noise adds ≈ H_b(0.2) + 0.2·log2(K-1) = 1.7638 bits of irreducible label entropy\n"]}],"source":["X38_tr, X38_te, y38_tr, y38_te = train_test_split(X38, y38, test_size=0.3, stratify=y38, random_state=SEED)\n","c38 = np.unique(y38); K38 = len(c38); m38 = {c: i for i, c in enumerate(c38)}\n","y38_tr = np.array([m38[c] for c in y38_tr]); y38_te = np.array([m38[c] for c in y38_te])\n","def add_noise(lbl, rate, k, seed=SEED):\n","    r_ = np.random.default_rng(seed); out = lbl.copy(); flip = r_.random(len(lbl)) < rate\n","    out[flip] = (lbl[flip] + r_.integers(1, k, flip.sum())) % k   # uniform over the OTHER classes\n","    return out\n","y38_noisy = add_noise(y38_tr, 0.20, K38)\n","p38 = np.bincount(y38_tr, minlength=K38) / len(y38_tr)\n","A = pd.DataFrame({'K': [K, K38], 'H(p) bits': [f4(H(p_cls)), f4(H(p38))], 'log2 K (max)': [f4(np.log2(K)), f4(np.log2(K38))],\n","                  'CE at init = log2 K': [f4(np.log2(K)), f4(np.log2(K38))], 'chance acc 1/K': [f4(1 / K), f4(1 / K38)],\n","                  'majority acc': [f4(p_cls.max()), f4(p38.max())]}, index=['original tomato', '38-class']); display(A)\n","print('actual flipped fraction =', f4((y38_noisy != y38_tr).mean()))\n","eta = 0.2; print(f'With symmetric noise η=0.2 a perfect classifier scores only {f4(1 - eta)} accuracy on NOISY labels; '\n","                 f'noise adds ≈ H_b(0.2) + 0.2·log2(K-1) = {f4(-(0.2*np.log2(0.2) + 0.8*np.log2(0.8)) + 0.2*np.log2(K38-1))} bits of irreducible label entropy')"]},{"cell_type":"markdown","id":"1b6f9b86","metadata":{"id":"1b6f9b86"},"source":["**A. Impact (points to analyse):** label space 10 → 38: entropy ceiling and initial CE rise to $\\log_2 38=5.2479$ bits, chance accuracy falls, more\n","boundaries for a linear model, fewer images per class. 20 % noise: irreducible error ↑ (Bayes error on noisy labels ≥ 0.2), *variance* ↑ for\n","high-capacity models that memorise flipped labels, measured validation error is biased upwards if validation labels are noisy.\n","Broken assumptions: clean labels, unlimited memory/latency (k-NN stores the whole training set), 10 classes.\n","\n","### B. Measure Each Candidate under the New Conditions\n","Every model is trained once on clean and once on **noisy** labels and tested on clean labels. Single-image latency is measured in Colab and scaled to a low-cost phone:\n","$$t_{phone}\\approx t_{Colab}\\times\\texttt{PHONE\\_SLOWDOWN}$$"]},{"cell_type":"code","execution_count":null,"id":"b13616c8","metadata":{"execution":{"iopub.execute_input":"2026-10-12T04:30:47.568710Z","iopub.status.busy":"2026-10-12T04:30:47.568463Z","iopub.status.idle":"2026-10-12T04:32:01.220766Z","shell.execute_reply":"2026-10-12T04:32:01.219210Z"},"id":"b13616c8","outputId":