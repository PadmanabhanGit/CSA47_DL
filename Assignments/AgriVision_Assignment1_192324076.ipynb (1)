0, len(Z_tr)); n_ev = min(1000, len(Z_va))\n","Zb, yb_, Ze, ye = Z_tr[:n_bs], y_tr[:n_bs], Z_va[:n_ev], y_va[:n_ev]\n","E = np.eye(K)[ye]\n","def bv(make):\n","    P, preds = [], []\n","    for b in range(B):\n","        i = rng.integers(0, n_bs, n_bs); m = make().fit(Zb[i], yb_[i])\n","        pp = np.zeros((n_ev, K)); pp[:, m.classes_] = m.predict_proba(Ze); P.append(pp); preds.append(pp.argmax(1))\n","    P, preds = np.array(P), np.array(preds); Pbar = P.mean(0)\n","    err = ((P - E)**2).sum(2).mean(); bias2 = ((Pbar - E)**2).sum(1).mean(); var = ((P - Pbar)**2).sum(2).mean()\n","    main = np.array([np.bincount(c, minlength=K).argmax() for c in preds.T])\n","    return dict(err=f4(err), bias2=f4(bias2), var=f4(var), sum=f4(bias2 + var),\n","                err01=f4((preds != ye).mean()), bias01=f4((main != ye).mean()), var01=f4((preds != main).mean()))\n","bvt = pd.DataFrame({'low capacity: tree depth 2': bv(lambda: DecisionTreeClassifier(max_depth=2, random_state=SEED)),\n","                    'high capacity: tree depth ∞': bv(lambda: DecisionTreeClassifier(random_state=SEED))}).T\n","bvt.columns = ['Brier error', 'bias²', 'variance', 'bias²+var', '0-1 error', '0-1 bias', '0-1 variance']\n","display(bvt)"]},{"cell_type":"markdown","id":"e4677af1","metadata":{"id":"e4677af1"},"source":["### Check with Known Noise (Regression)\n","$y=\\sin(2\\pi x)+\\varepsilon$, $\\varepsilon\\sim\\mathcal N(0,\\sigma^2)$, $\\sigma^2=0.09$. Over 200 fresh training sets:\n","$$\\mathbb E\\big[(y-\\hat f(x))^2\\big]=\\underbrace{\\big(f(x)-\\mathbb E[\\hat f(x)]\\big)^2}_{\\text{bias}^2}+\\underbrace{\\mathbb E\\big[(\\hat f(x)-\\mathbb E\\hat f(x))^2\\big]}_{\\text{variance}}+\\sigma^2$$"]},{"cell_type":"code","execution_count":null,"id":"aa918a26","metadata":{"execution":{"iopub.execute_input":"2026-10-12T04:22:34.012306Z","iopub.status.busy":"2026-10-12T04:22:34.012018Z","iopub.status.idle":"2026-10-12T04:22:34.151914Z","shell.execute_reply":"2026-10-12T04:22:34.150594Z"},"id