0.7059   0.0040   0.0004\n","3    50    0.0883  0.0380    0.0859  0.0194          0.4898   0.0014   0.0004\n","4   100    0.0883  0.0291    0.0867  0.0196          0.3243   0.0008   0.0004\n","5   200    0.0851  0.0199    0.0847  0.0161          0.1935   0.0004   0.0003\n","6   500    0.0855  0.0123    0.0853  0.0112          0.0876   0.0002   0.0001\n","7  1000    0.0880  0.0085    0.0878  0.0082          0.0458   0.0001   0.0001\n","8  5000    0.0875  0.0036    0.0875  0.0035          0.0095   0.0000   0.0000"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 770x440 with 1 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["hc = CLASSES.index('healthy') if 'healthy' in CLASSES else K - 1\n","a_, b_ = 5, 45; theta_true = (y == hc).mean()\n","s = rng.permutation(len(y))[:20]; k20 = int((y[s] == hc).sum())\n","print(f'class = {CLASSES[hc]}, full-data proportion = {f4(theta_true)}')\n","print(f'Worked example n=20: k={k20}  MLE = {k20}/20 = {f4(k20/20)}  MAP = ({k20}+4)/(20+48) = {f4((k20+a_-1)/(20+a_+b_-2))}')\n","ns = [n for n in [5, 10, 20, 50, 100, 200, 500, 1000, 5000] if n < len(y)]; rows = []\n","for n in ns:\n","    ks_ = np.array([(y[rng.choice(len(y), n, replace=False)] == hc).sum() for _ in range(200)])\n","    mle, mapp = ks_ / n, (ks_ + a_ - 1) / (n + a_ + b_ - 2)\n","    rows.append([n, f4(mle.mean()), f4(mle.std()), f4(mapp.mean()), f4(mapp.std()), f4((a_ + b_ - 2) / (n + a_ + b_ - 2)),\n","                 f4(np.mean((mle - theta_true)**2)), f4(np.mean((mapp - theta_true)**2))])\n","mm = pd.DataFrame(rows, columns=['n', 'MLE mean', 'MLE sd', 'MAP mean', 'MAP sd', 'prior weight w', 'MSE MLE', 'MSE MAP']); display(mm)\n","plt.figure(figsize=(7, 4)); plt.semilogx(ns, mm['MSE MLE'], 'o-', label='MLE'); plt.semilogx(ns, mm['MSE MAP'], 's-', label='MAP Beta(5,45)')\n","plt.xlabel('sample size n'); plt.ylabel('MSE of estimate'); plt.title('MLE vs MAP error as n grows'); plt.legend(); plt.show()"]},{"cell_type":"markdown","id":"16676e84","metadata":{"id":"16676e84"},"source":[">at small n MAP trades a little bias for much lower variance; w → 0 as n grows so both converge."]},{"cell_type":"markdown","id":"27d1c338","metadata":{"id":"27d1c338"},"source":["## Task 8 — Gradient-Based Optimisation of Softmax Regression (from scratch) (4 marks)\n","\n","**Model:** $z_i = W^\\top x_i$ (bias folded in), $p_i=\\text{softmax}(z_i)$. **Loss:** $J(W)=-\\frac1N\\sum_i\\sum_k Y_{ik}\\log p_{ik}+\\frac{\\lambda}{2}\\|W\\|^2$.\n","\n","**Gradient derivation.** For one sample, $\\ell=-\\sum_k y_k\\log p_k$ with $p_k=e^{z_k}/\\sum_j e^{z_j}$.\n","1. $\\frac{\\partial \\log p_k}{\\partial z_j}=\\delta_{kj}-p_j$\n","2. $\\frac{\\partial \\ell}{\\partial z_j}=-\\sum_k y_k(\\delta_{kj}-p_j)=-y_j+p_j\\sum_k y_k=p_j-y_j$  (since $\\sum_k y_k=1$)\n","3. $z_j=w_j^\\top x\\Rightarrow\\frac{\\partial \\ell}{\\partial w_j}=(p_j-y_j)\\,x$\n","4. Batch form: $\\boxed{\\nabla_W J=\\frac1N X^\\top(P-Y)+\\lambda W}$\n","\n","Each update is driven by the **error signal** $P-Y$ (confident correct samples contribute ≈0; confident mistakes dominate) times the **input** $x$\n","(large-variance feature directions get large updates → link to conditioning)."]},{"cell_type":"code","execution_count":null,"id":"47e0786f","metadata":{"execution":{"iopub.execute_input":"2026-10-12T04:22:34.581843Z","iopub.status.busy":"2026-10-12T04:22:34.581508Z","iopub.status.idle":"2026-10-12T04:22:34.602703Z","shell.execute_reply":"2026-10-12T04:22:34.600981Z"},"id":"47e0786f","outputId":"3d31194f-470b-4b57-aed7-bdc32cf43f34","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1791961797104,"user_tz":-330,"elapsed":1,"user":{"displayName":"Padmanabhan S","userId":"00156433950367292426"}}},"outputs":[{"metadata":{"tags":null},"name":"stdout","output_type":"stream","text":["max |analytic - numerical gradient| = 2.37e-10\n"]}],"source":["def softmax_rows(Zm): Zm = Zm - Zm.max(1, keepdims=True); Em = np.exp(Zm); return Em / Em.sum(1, keepdims=True)\n","def add_bias(A): return np.hstack([A, np.ones((len(A), 1))])\n","def loss_grad(W, Xb, Yb, lam=1e-4):\n","    P = softmax_rows(Xb @ W)\n","    loss = -np.mean(np.sum(Yb * np.log(np.clip(P, 1e-12, 1)), 1)) + lam / 2 * np.sum(W[:-1]**2)\n","    G = Xb.T @ (P - Yb) / len(Xb); G[:-1] += lam * W[:-1]\n","    return loss, G\n","def train_softmax(Xa, Ya, lr, batch, epochs, Xv=None, yv=None, seed=0):\n","    r_ = np.random.default_rng(seed); W = np.zeros((Xa.shape[1], Ya.shape[1])); hist, steps, t0 = [], [], time.time()\n","    for ep in range(epochs):\n","        idx = r_.permutation(len(Xa))\n","        for s0 in range(0, len(Xa), batch):\n","            b = idx[s0:s0 + batch]; l, G = loss_grad(W, Xa[b], Ya[b]); W -= lr * G; steps.append(l)\n","        hist.append(loss_grad(W, Xa, Ya)[0])\n","        if not np.isfinite(hist[-1]) or hist[-1] > 1e6: hist += [np.nan] * (epochs - ep - 1); break\n","    return W, np.array(hist), np.array(steps), time.time() - t0\n","\n","# numerical gradient check\n","Xg = add_bias(rng.standard_normal((20, 5))); Yg = np.eye(3)[rng.integers(0, 3, 20)]; Wg = rng.standard_normal((6, 3)) * .1\n","_, Ga = loss_grad(Wg, Xg, Yg); Gn = np.zeros_like(Wg); h = 1e-6\n","for i in range(Wg.shape[0]):\n","    for j in range(Wg.shape[1]):\n","        Wp, Wm = Wg.copy(), Wg.copy(); Wp[i, j] += h; Wm[i, j] -= h\n","        Gn[i, j] = (loss_grad(Wp, Xg, Yg)[0] - loss_grad(Wm, Xg, Yg)[0]) / (2 * h)\n","print('max |analytic - numerical gradient| =', f'{np.abs(Ga - Gn).max():.2e}')"]},{"cell_type":"markdown","id":"873bffd5","metadata":{"id":"873bffd5"},"source":["### Conditioning of the Softmax-Regression Inputs\n","**Hessian of the softmax cross-entropy**\n","$$\\nabla^2 J=\\big(\\text{diag}(p)-pp^\\top\\big)\\otimes\\frac{X^\\top X}{N},\\qquad \\lambda_{\\max}\\big(\\text{diag}(p)-pp^\\top\\big)\\le\\tfrac12\\ \\Rightarrow\\ \\lambda_{\\max}(\\nabla^2J)\\le\\frac{\\lambda_{\\max}(X^\\top X/N)}{2}$$\n","**Critical learning rate** (safe for every $W$)\n","$$\\eta_{crit}=\\frac{2}{\\lambda_{\\max}(\\nabla^2 J)}=\\frac{4}{\\lambda_{\\max}(X^\\top X/N)}$$\n","Compared for unwhitened PCA-50 scores vs whitened (standardised) PCA-50 scores."]},{"cell_type":"code","execution_count":null,"id":"f028c415","metadata":{"execution":{"iopub.execute_input":"2026-10-12T04:22:34.605773Z","iopub.status.busy":"2026-10-12T04:22:34.605427Z","iopub.status.idle":"2026-10-12T04:22:37.497198Z","shell.execute_reply":"2026-10-12T04:22:37.492772Z"},"id":"f028c415","outputId":"ca948571-6371-432d-dc4f-60195b893d94","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1791961797150,"user_tz":-330,"elapsed":3,"user":{"displayName":"Padmanabhan S","userId":"00156433950367292426"}}},"outputs":[{"metadata":{"tags":null},"name":"stdout","output_type":"stream","text":["unwhitened PCA-50: λmax(XᵀX/N) = 16.7727, κ = 104.6735, η_crit = 4/λmax = 0.2385\n","whitened   PCA-50: λmax(XᵀX/N) = 1.0011, κ = 1.0019, η_crit = 3.9957\n"]}],"source":["D8 = 50\n","pca50 = PCA(D8, random_state=SEED).fit(X_tr)\n","F_raw = add_bias(pca50.transform(X_tr)); Fv_raw = add_bias(pca50.transform(X_va))\n","sc50 = StandardScaler().fit(pca50.transform(X_tr))\n","F_w = add_bias(sc50.transform(pca50.transform(X_tr))); Fv_w = add_bias(sc50.transform(pca50.transform(X_va)))\n","Ytr = np.eye(K)[y_tr]\n","def eig_info(F): ev = np.linalg.eigvalsh(F.T @ F / len(F)); return ev.max(), ev.max() / ev.min()\n","lmax_raw, kap_raw = eig_info(F_raw); lmax_w, kap_w = eig_info(F_w)\n","# Hessian = (diag(p) - pp^T) ⊗ XᵀX/N and λmax(diag(p) - pp^T) <= 1/2  ->  λmax(H) <= λmax(XᵀX/N)/2\n","eta_crit_raw, eta_crit_w = 4 / lmax_raw, 4 / lmax_w\n","print(f'unwhitened PCA-50: λmax(XᵀX/N) = {f4(lmax_raw)}, κ = {f4(kap_raw)}, η_crit = 4/λmax = {f4(eta_crit_raw)}')\n","print(f'whitened   PCA-50: λmax(XᵀX/N) = {f4(lmax_w)}, κ = {f4(kap_w)}, η_crit = {f4(eta_crit_w)}')"]},{"cell_type":"markdown","id":"f26a88d2","metadata":{"id":"f26a88d2"},"source":["### Batch GD vs Mini-batch SGD vs SGD\n","**Update rule** (batch $\\mathcal B$ of size $B$)\n","$$W\\leftarrow W-\\eta\\left[\\frac{1}{B}X_{\\mathcal B}^\\top(P_{\\mathcal B}-Y_{\\mathcal B})+\\lambda W\\right]$$\n","$B=N$: batch GD (1 update/epoch) · $B=32$: mini-batch · $B=1$: SGD ($N$ updates/epoch)."]},{"cell_type":"code","execution_count":null,"id":"3fd8ef4c","metadata":{"execution":{"iopub.execute_input":"2026-10-12T04:22:37.500584Z","iopub.status.busy":"2026-10-12T04:22:37.500322Z","iopub.status.idle":"2026-10-12T04:23:02.367069Z","shell.execute_reply":"2026-10-12T04:23:02.365979Z"},"id":"3fd8ef4c","outputId":"b76b2725-9735-445c-c2c8-515c318d8e25","colab":{"base_uri":"https://localhost:8080/","height":402},"executionInfo":{"status":"ok","timestamp":1791961826217,"user_tz":-330,"elapsed":29125,"user":{"displayName":"Padmanabhan S","userId":"00156433950367292426"}}},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1540x440 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["                strategy  batch      η  updates/epoch  sec/epoch  final loss  \\\n","0         Batch GD (B=N)  12712 1.9978              1     0.0129      1.5442   \n","1  Mini-batch SGD (B=32)     32 0.0500            398     0.0513      1.5365   \n","2              SGD (B=1)      1 0.0050          12712     0.7417      1.5601   \n","\n","   loss noise (sd, last epoch)  val acc  \n","0                       0.0000   0.4849  \n","1                       0.1937   0.4860  \n","2                       1.2156   0.4835  "],"text/html":["\n","  <div id=\"df-d4e78334-f7e3-4b94-8a85-6187224430ed\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: