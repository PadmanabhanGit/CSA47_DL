 (lambda c: make_pipeline(StandardScaler(), LogisticRegression(C=c, max_iter=300)), list(np.logspace(-5, 2, 8))),\n","}\n","curves = {}\n","fig, ax = plt.subplots(1, 3, figsize=(16, 4))\n","for a, (nm, (mk, grid)) in zip(ax, fam.items()):\n","    tr, va = curve(mk, grid); curves[nm] = (grid, tr, va)\n","    xs = np.arange(len(grid)); a.plot(xs, tr, 'o-', label='train error'); a.plot(xs, va, 's-', label='validation error')\n","    a.set_xticks(xs); a.set_xticklabels([('∞' if g is None else (f'{g:.0e}' if isinstance(g, float) else g)) for g in grid], rotation=45, fontsize=8)\n","    a.axvline(np.argmin(va), c='g', ls='--', label='best val'); a.set(title=nm, xlabel='capacity →', ylabel='error'); a.legend(fontsize=8)\n","plt.tight_layout(); plt.show()\n","display(pd.DataFrame({nm: {'best setting': g[np.argmin(v)], 'train err': f4(t[np.argmin(v)]), 'val err': f4(v.min()),\n","                           'gap at best': f4(v.min() - t[np.argmin(v)]), 'gap at max capacity': f4(v[-1] - t[-1])}\n","                      for nm, (g, t, v) in curves.items()}))"]},{"cell_type":"markdown","id":"0a700538","metadata":{"id":"0a700538"},"source":["### Annotated capacity plot (C1 → C5)"]},{"cell_type":"code","execution_count":null,"id":"fd1d2c35","metadata":{"execution":{"iopub.execute_input":"2026-10-12T04:20:31.176347Z","iopub.status.busy":"2026-10-12T04:20:31.176037Z","iopub.status.idle":"2026-10-12T04:20:31.535405Z","shell.execute_reply":"2026-10-12T04:20:31.533331Z"},"id":"fd1d2c35","outputId":"0c420af4-99e1-4815-bd18-f411545d205e","colab":{"base_uri":"https://localhost:8080/","height":563},"executionInfo":{"status":"ok","timestamp":1791961612728,"user_tz":-330,"elapsed":1099,"user":{"displayName":"Padmanabhan S","userId":"00156433950367292426"}}},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 990x550 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["  capacity  train err  val err     gap\n","0   C1 (1)     0.7050   0.7048 -0.0002\n","1   C2 (3)     0.6134   0.6171  0.0037\n","2   C3 (8)     0.4416   0.5330  0.0915\n","3  C4 (14)     0.1408   0.5811  0.4403\n","4   C5 (∞)     0.0000   0.6013  0.6013\n"]}],"source":["# Pick the family whose optimum is most interior and sample 5 capacity levels around it\n","def interior(v): o = int(np.argmin(v)); return min(o, len(v) - 1 - o)\n","fam_name = max(curves, key=lambda n: interior(curves[n][2]))\n","grid, tr, va = curves[fam_name]; o = int(np.argmin(va)); L = len(grid) - 1\n","sel = sorted(set([0, o // 2, o, o + (L - o + 1) // 2, L]))\n","while len(sel) < 5: sel = sorted(set(sel + [next(i for i in range(L + 1) if i not in sel)]))\n","sel = sel[:5]\n","labels = [f'C{i+1}\\n({\"∞\" if grid[j] is None else (f\"{grid[j]:.0e}\" if isinstance(grid[j], float) else grid[j])})' for i, j in enumerate(sel)]\n","tr5, va5 = tr[sel], va[sel]; opt = int(np.argmin(va5)); x5 = np.arange(1, 6)\n","\n","fig, a = plt.subplots(figsize=(9, 5))\n","a.axvspan(0.6, x5[opt], color='tab:blue', alpha=.08, label='underfitting region')\n","a.axvspan(x5[opt], 5.4, color='tab:red', alpha=.08, label='overfitting region')\n","a.plot(x5, tr5, 'o-', lw=2, label='training error'); a.plot(x5, va5, 's-', lw=2, label='validation error')\n","a.axvline(x5[opt], c='g', ls='--', lw=2, label=f'optimal capacity ({labels[opt].split()[0]})')\n","g = int(np.argmax(va5 - tr5))\n","a.annotate('', xy=(x5[g], tr5[g]), xytext=(x5[g], va5[g]), arrowprops=dict(arrowstyle='<->', color='k', lw=1.5))\n","a.text(x5[g] + 0.05, (tr5[g] + va5[g]) / 2, f'generalisation gap\\n= {f4(va5[g] - tr5[g])}', fontsize=9)\n","a.set_xticks(x5); a.set_xticklabels(labels); a.set_xlim(0.6, 5.4)\n","a.set(title=f'Training vs validation error against model capacity — {fam_name}', xlabel='Model capacity (C1 = lowest → C5 = highest)', ylabel='Error rate (1 − accuracy)')\n","a.legend(loc='upper right', fontsize=8); plt.tight_layout(); plt.show()\n","print(pd.DataFrame({'capacity': [l.replace('\\n', ' ') for l in labels], 'train err': tr5.round(4), 'val err': va5.round(4), 'gap': (va5 - tr5).round(4)}))"]},{"cell_type":"markdown","id":"ccca5c28","metadata":{"id":"ccca5c28"},"source":["**Causes:** *underfitting* (left) – hypothesis too simple to represent the class boundaries, both errors high, gap small (high bias);\n","*overfitting* (right) – model fits pixel noise / individual images (k=1, unlimited depth → train error ≈ 0), gap large (high variance).\n","\n","### Test-set selection bias"]},{"cell_type":"code","execution_count":null,"id":"fc4b797b","metadata":{"execution":{"iopub.execute_input":"2026-10-12T04:20:31.538253Z","iopub.status.busy":"2026-10-12T04:20:31.538004Z","iopub.status.idle":"2026-10-12T04:21:54.431101Z","shell.execute_reply":"2026-10-12T04:21:54.428863Z"},"id":"fc4b797b","outputId":"69d32a3b-f6e4-4101-ef75-bd91224a5716","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1791961732231,"user_tz":-330,"elapsed":119499,"user":{"displayName":"Padmanabhan S","userId":"00156433950367292426"}}},"outputs":[{"output_type":"stream","name":"stdout","text":["selected on test-half A: k-NN (capacity = 1/k) = 1\n","  accuracy reported on A (biased) = 0.4949 | on fresh half B (unbiased) = 0.4743 | optimism = 0.0206\n","5-fold CV accuracy of k-NN(k=5) on train: 0.464 ± 0.0073\n"]}],"source":["# Choose the best of all configurations on half of the test set (A), then report on A vs the untouched half (B)\n","iA, iB = train_test_split(np.arange(len(y_te)), test_size=0.5, stratify=y_te, random_state=SEED)\n","res = []\n","for nm, (mk, grid) in fam.items():\n","    for gval in grid:\n","        p = mk(gval).fit(Z_tr, y_tr).predict(Z_te); res.append((nm, gval, accuracy_score(y_te[iA], p[iA]), accuracy_score(y_te[iB], p[iB])))\n","best = max(res, key=lambda r_: r_[2])\n","cv = cross_val_score(KNeighborsClassifier(5), Z_tr, y_tr, cv=StratifiedKFold(5, shuffle=True, random_state=SEED))\n","print(f'selected on test-half A: {best[0]} = {best[1]}')\n","print(f'  accuracy reported on A (biased) = {f4(best[2])} | on fresh half B (unbiased) = {f4(best[3])} | optimism = {f4(best[2] - best[3])}')\n","print(f'5-fold CV accuracy of k-NN(k=5) on train: {f4(cv.mean())} ± {f4(cv.std())}')"]},{"cell_type":"markdown","id":"e7625667","metadata":{"id":"e7625667"},"source":["Choosing the max over many configurations on the same data you report on picks up the configuration that was *luckiest* on that sample →\n","the reported error is optimistically biased (selection effect, \"winner's curse\"). A validation set or k-fold CV makes selection on data that is\n","independent of the final test estimate."]},{"cell_type":"markdown","id":"acb32a62","metadata":{"id":"acb32a62"},"source":["> 📝 **What this means for AgriVision** *(write 1–2 lines in your own words after running)*:"]},{"cell_type":"markdown","id":"7eacd543","metadata":{"id":"7eacd543"},"source":["## Task 7 — Bias–Variance Decomposition and MLE vs MAP (4 marks)\n","\n","Bootstrap: train $B$ models $\\hat f_b$ on resamples of the training set; $\\bar f(x)=\\frac1B\\sum_b\\hat f_b(x)$.\n","Using squared error on probability vectors (Brier) with one-hot target $\\mathbf e_y$:\n","$$\\underbrace{\\tfrac1B\\textstyle\\sum_b\\|\\hat f_b(x)-\\mathbf e_y\\|^2}_{\\text{measured error}}=\\underbrace{\\|\\bar f(x)-\\mathbf e_y\\|^2}_{\\text{bias}^2(+\\text{noise})}+\\underbrace{\\tfrac1B\\textstyle\\sum_b\\|\\hat f_b(x)-\\bar f(x)\\|^2}_{\\text{variance}}$$\n","With observed labels the irreducible noise cannot be separated and sits inside the bias term."]},{"cell_type":"code","execution_count":null,"id":"0288a646","metadata":{"execution":{"iopub.execute_input":"2026-10-12T04:21:54.434598Z","iopub.status.busy":"2026-10-12T04:21:54.434351Z","iopub.status.idle":"2026-10-12T04:22:34.009794Z","shell.execute_reply":"2026-10-12T04:22:34.008253Z"},"id":"0288a646","outputId":"977e78bb-1706-4a1f-feed-f5fdf69191d3","colab":{"base_uri":"https://localhost:8080/","height":164},"exe