 isinstance(s[1], PCA))\n","    if isinstance(est, LogisticRegression): return est.coef_.size + est.intercept_.size + extra\n","    if isinstance(est, KNeighborsClassifier): return est.n_samples_fit_ * est.n_features_in_ + extra\n","    return sum(t.tree_.node_count for t in est.estimators_) + extra   # RF: number of tree nodes\n","def pipelines(feat):\n","    pre = [PCA(K_PCA, random_state=SEED)] if feat == 'PCA' else []\n","    return {'LogReg': make_pipeline(*pre, StandardScaler(), LogisticRegression(max_iter=300)),\n","            'k-NN': make_pipeline(*pre, *([] if pre else [StandardScaler()]), KNeighborsClassifier(5)),\n","            'RandomForest': make_pipeline(*pre, RandomForestClassifier(100, n_jobs=-1, random_state=SEED))}\n","rows, fitted = [], {}\n","for n in scales:\n","    i = np.arange(len(y_pool)) if n == len(y_pool) else train_test_split(np.arange(len(y_pool)), train_size=n, stratify=y_pool, random_state=SEED)[0]\n","    for feat in ['raw', 'PCA']:\n","        for nm, m in pipelines(feat).items():\n","            t = time.time(); m.fit(X_pool[i], y_pool[i]); ttr = time.time() - t\n","            t = time.time(); pr = m.predict(X_te); tin = (time.time() - t) / len(X_te) * 1000\n","            P_, R_, F_, _ = precision_recall_fscore_support(y_te, pr, average='macro', zero_division=0)\n","            rows.append([n, feat, nm, f4(accuracy_score(y_te, pr)), f4(P_), f4(R_), f4(F_), f4(ttr), f4(tin), n_params(m), f4(len(pickle.dumps(m)) / 2**20)])\n","            fitted[(n, feat, nm)] = (m, pr)\n","        print('done scale', n, feat)\n","perf = pd.DataFrame(rows, columns=['n', 'features', 'model', 'accuracy', 'precision', 'recall', 'F1', 'train s', 'infer ms/img', 'params', 'size MB'])\n","display(perf)"]},{"cell_type":"markdown","id":"9734af15","metadata":{"id":"9734af15"},"source":["### Performance Plots and Confusion Matrix\n","**Confusion matrix** $M_{ij}$ = number of test images of true class $i$ predicted as class $j$; off-diagonal maxima = most-confused pairs.\n","**Per-class metrics**\n","$$\\text{Precision}_k=\\frac{M_{kk}}{\\sum_i M_{ik}},\\qquad \\text{Recall}_k=\\frac{M_{kk}}{\\sum_j M_{kj}}$$"]},{"cell_type":"code","execution_count":null,"id":"3b58ae75","metadata":{"execution":{"iopub.execute_input":"2026-10-12T04:29:30.129832Z","iopub.status.busy":"2026-10-12T04:29:30.129515Z","iopub.status.idle":"2026-10-12T04:29:31.735028Z","shell.execute_reply":"2026-10-12T04:29:31.733440Z"},"id":"3b58ae75","outputId":"03e9028c-c506-487e-b51c-fa1919f4ed3d","colab":{"base_uri":"https://localhost:8080/","height":1000},"executionInfo":{"status":"ok","timestamp":1791962378395,"user_tz":-330,"elapsed":11784,"user":{"displayName":"Padmanabhan S","userId":"00156433950367292426"}}},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1870x440 with 3 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Best at full scale: RandomForest raw | F1 = 0.5358\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 880x770 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["           true class                   predicted as  count\n","0      Bacterial_spot  Tomato_Yellow_Leaf_Curl_Virus     88\n","1         Late_blight  Tomato_Yellow_Leaf_Curl_Virus     74\n","2           Leaf_Mold  Tomato_Yellow_Leaf_Curl_Virus     67\n","3  Septoria_leaf_spot  Tomato_Yellow_Leaf_Curl_Virus     64\n","4        Early_blight  Tomato_Yellow_Leaf_Curl_Virus     63"],"text/html":["\n","  <div id=\"df-8c49ac0b-3f7d-4c9e-8554-8d9a3f14e048\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr