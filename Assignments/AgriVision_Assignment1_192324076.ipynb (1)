23,\n          0.9991657231392647,\n          0.018929633300297285\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["numerical rank of raw covariance: 4096 of 4096\n"]}],"source":["# Conditioning of the feature covariance\n","tol = lam[0] * 1e-10\n","num_rank = int((lam > tol).sum())\n","kappa_raw = lam[0] / lam[num_rank - 1]\n","Zs = StandardScaler().fit_transform(Z_tr)\n","lam_z = np.linalg.eigvalsh(np.cov(Z_tr, rowvar=False))[::-1]\n","cond = pd.DataFrame({'features': ['raw pixels (centred)', f'PCA-{K_PCA} scores', f'PCA-{K_PCA} standardised (whitened)'],\n","                     'lambda_max': [f4(lam[0]), f4(lam_z[0]), f4(np.linalg.eigvalsh(np.cov(Zs, rowvar=False)).max())],\n","                     'lambda_min (non-zero)': [lam[num_rank - 1], f4(lam_z[-1]), f4(np.linalg.eigvalsh(np.cov(Zs, rowvar=False)).min())]})\n","cond['condition number κ'] = cond['lambda_max'] / cond['lambda_min (non-zero)']\n","cond['GD contraction (κ-1)/(κ+1)'] = (cond['condition number κ'] - 1) / (cond['condition number κ'] + 1)\n","display(cond); print('numerical rank of raw covariance:', num_rank, 'of', X.shape[1])"]},{"cell_type":"markdown","id":"3dc7520f","metadata":{"id":"3dc7520f"},"source":["For a quadratic loss with Hessian eigenvalues $\\lambda_{\\max},\\lambda_{\\min}$, GD with the best fixed step converges as\n","$\\|w_t-w^*\\|\\le\\left(\\frac{\\kappa-1}{\\kappa+1}\\right)^t\\|w_0-w^*\\|$, $\\kappa=\\lambda_{\\max}/\\lambda_{\\min}$, and is stable only for $\\eta<2/\\lambda_{\\max}$.\n","Huge κ → the step size is capped by the steep direction while the flat directions barely move → slow, zig-zagging training (tested in Task 8)."]},{"cell_type":"markdown","id":"9c134888","metadata":{"id":"9c134888"},"source":["## Task 5 — Differentiate Baseline Learning Strategies (4 marks)\n","\n","| Model | Hypothesis space | Inductive bias |\n","|---|---|---|\n","| Multinomial logistic regression | Linear decision boundaries $\\arg\\max_k w_k^\\top x+b_k$ | classes linearly separable; smooth, global; L2 → small weights |\n","| k-NN (k=5) | Any boundary, piecewise (Voronoi) | **local constancy**: nearby in Euclidean pixel space ⇒ same class |\n","| Random forest | Axis-aligned piecewise-constant regions, averaged | individual features (pixels) carry thresholdable information; bagging reduces variance |"]},{"cell_type":"code","execution_count":null,"id":"39065377","metadata":{"execution":{"iopub.execute_input":"2026-10-12T04:16:16.253928Z","iopub.status.busy":"2026-10-12T04:16:16.253368Z","iopub.status.idle":"2026-10-12T04:18:42.650450Z","shell.execute_reply":"2026-10-12T04:18:42.649269Z"},"id":"39065377","outputId":"a382b2f6-1504-4251-b86e-a249ddd60db2","colab":{"base_uri":"https://localhost:8080/","height":206},"executionInfo":{"status":"ok","timestamp":1791961449308,"user_tz":-330,"elapsed":234208,"user":{"displayName":"Padmanabhan S","userId":"00156433950367292426"}}},"outputs":[{"output_type":"display_data","data":{"text/plain":["                              val acc          train s         \n","features                      PCA-560 raw 4096 PCA-560 raw 4096\n","model                                                          \n","LogReg (linear, parametric)    0.4677   0.3634  1.9272  89.1110\n","Random Forest (tree ensemble)  0.4805   0.6648 57.5828  76.7835\n","k-NN k=5 (non-parametric)      0.4640   0.4515  0.0054   0.7501"],"text/html":["\n","  <div id=\"df-7111a816-991a-4102-ba92-343dd5051754\" class=\"colab-df-container\">\n","    <div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead tr th {\n","        text-align: left;\n","    }\n","\n","    .dataframe thead tr:last-of-type th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1