6, 'F1': 0.3575, 'params': 23946, 'size_MB': 0.0913, 'train_s': 25.5279, 'infer_ms_single': 7.5206}\n"]}],"source":["RUN_CNN = not TEST_MODE     # small CNN as a reference point for the analysis (uses TensorFlow in Colab)\n","cnn_res = None\n","if RUN_CNN:\n","    try:\n","        import tensorflow as tf\n","        tf.random.set_seed(SEED)\n","        cnn = tf.keras.Sequential([tf.keras.layers.Input((IMG, IMG, 1)),\n","            tf.keras.layers.Conv2D(16, 3, activation='relu', padding='same'), tf.keras.layers.MaxPool2D(),\n","            tf.keras.layers.Conv2D(32, 3, activation='relu', padding='same'), tf.keras.layers.MaxPool2D(),\n","            tf.keras.layers.Conv2D(64, 3, activation='relu', padding='same'), tf.keras.layers.GlobalAveragePooling2D(),\n","            tf.keras.layers.Dense(K, activation='softmax')])\n","        cnn.compile('adam', 'sparse_categorical_crossentropy', metrics=['accuracy'])\n","        t = time.time(); cnn.fit(X_tr.reshape(-1, IMG, IMG, 1), y_tr, validation_data=(X_va.reshape(-1, IMG, IMG, 1), y_va), epochs=10, batch_size=64, verbose=2); ttr = time.time() - t\n","        pr = cnn.predict(X_te.reshape(-1, IMG, IMG, 1), verbose=0).argmax(1)\n","        one = X_te[:1].reshape(1, IMG, IMG, 1); cnn(one); t = time.time(); [cnn(one) for _ in range(50)]; tin = (time.time() - t) / 50 * 1000\n","        cnn_res = dict(accuracy=f4(accuracy_score(y_te, pr)), F1=f4(precision_recall_fscore_support(y_te, pr, average='macro')[2]),\n","                       params=cnn.count_params(), size_MB=f4(cnn.count_params() * 4 / 2**20), train_s=f4(ttr), infer_ms_single=f4(tin))\n","        print(cnn_res)\n","    except ImportError:\n","        print('TensorFlow not available – skipping CNN reference')"]},{"cell_type":"markdown","id":"dbbb421f","metadata":{"id":"dbbb421f"},"source":["### Summary Table: Best Classical Models vs CNN\n","Full-scale test results with parameter count, size and inference time side by side."]},{"cell_type":"code","execution_count":nu