": [\n        \"train s\",\n        \"raw 4096\"\n      ],\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 47.8551526668759,\n        \"min\": 0.7501,\n        \"max\": 89.111,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          89.111,\n          76.7835,\n          0.7501\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}}],"source":["def run(model, Xa, ya, Xb, yb):\n","    t = time.time(); model.fit(Xa, ya); tr = time.time() - t\n","    t = time.time(); pr = model.predict(Xb); inf = (time.time() - t) / len(Xb) * 1000\n","    return f4(accuracy_score(yb, pr)), f4(precision_recall_fscore_support(yb, pr, average='macro', zero_division=0)[2]), f4(tr), f4(inf)\n","\n","rows = []\n","for feat, (A, B) in {'raw 4096': (X_tr, X_va), f'PCA-{K_PCA}': (Z_tr, Z_va)}.items():\n","    for name, m in make_models().items():\n","        if feat == 'raw 4096' and name.startswith('k-NN'):\n","            m = make_pipeline(StandardScaler(), m)\n","        rows.append([name, feat, *run(m, A, y_tr, B, y_va)])\n","base = pd.DataFrame(rows, columns=['model', 'features', 'val acc', 'val macro-F1', 'train s', 'infer ms/img'])\n","display(base.pivot(index='model', columns='features', values=['val acc', 'train s']))"]},{"cell_type":"markdown","id":"aa5f65a4","metadata":{"id":"aa5f65a4"},"source":["**Points to analyse:** which model wins on raw vs PCA and why – e.g. k-NN benefits from PCA (denoises distances, fewer irrelevant dims);\n","RF may lose accuracy after PCA because PCs mix pixels and destroy the axis-aligned structure it splits on; LR changes little because PCA is\n","a rotation + truncation of a space it is already linear in, but trains much faster."]},{"cell_type":"markdown","id":"972c1eac","metadata":{"id":"972c1eac"},"source":["## Task 6 — Capacity, Overfitting and Underfitting (4 marks)\n","\n","Error $=1-$accuracy. Generalisation gap $=E_{val}-E_{train}$. Capacity in