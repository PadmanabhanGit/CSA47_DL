import numpy as np
import matplotlib.pyplot as plt

# Set print options for cleaner matrix outputs
np.set_printoptions(precision=3, suppress=True)
print("Libraries imported successfully!\n")

# ==========================================
# Task 1: Build Matrices C (6x5) and B (5x4)
# ==========================================

# Define names for clarity
customers = ['Cust_1', 'Cust_2', 'Cust_3', 'Cust_4', 'Cust_5', 'Cust_6']
genres = ['Sci-Fi', 'Mystery', 'Romance', 'History', 'Fantasy']
books = ['Book_A', 'Book_B', 'Book_C', 'Book_D']

# 1. Customer-Genre Matrix C (6x5) - Ratings from 1 to 5
C = np.array([,  # Cust_1: Loves Sci-Fi, Mystery, Fantasy,  # Cust_2: Loves Romance, History,  # Cust_3: Very similar to Cust_1,  # Cust_4: Similar to Cust_2,  # Cust_5: Neutral reader
    [4, 2, 5, 1, 4]   # Cust_6: Likes Sci-Fi, Romance, Fantasy
], dtype=float)

# 2. Genre-Book Matrix B (5x4) - Genre weights for each book
B = np.array([
    [0.8, 0.1, 0.0, 0.5],  # Sci-Fi
    [0.6, 0.2, 0.7, 0.1],  # Mystery
    [0.0, 0.9, 0.1, 0.3],  # Romance
    [0.1, 0.7, 0.8, 0.0],  # History
    [0.9, 0.0, 0.2, 0.8]   # Fantasy
], dtype=float)

print(f"Customer-Genre Matrix C (Shape: {C.shape}):\n", C)
print(f"\nGenre-Book Matrix B (Shape: {B.shape}):\n", B, "\n")

# ==========================================
# Task 2: Dot Products, Matrix Product, etc.
# ==========================================

# 1. Dot Product (Single Customer vs Single Book)
cust1_vec = C[0, :]       # Cust_1's genre ratings (1x5)
bookA_vec = B[:, 0]       # Book_A's genre weights (5x1)
dot_prod = np.dot(cust1_vec, bookA_vec)
print(f"1. Dot Product (Cust_1 & Book_A): {dot_prod:.2f}\n")

# 2. Matrix Product: Customer-Book Score Matrix S (6x5 @ 5x4 -> 6x4)
S = np.matmul(C, B)  # Alternatively: C @ B
print(f"2. Customer-Book Score Matrix S = C @ B (Shape: {S.shape}):\n", S, "\n")

# 3. Transpose of C (5x6)
C_T = C.T
print(f"3. Transpose of C (Shape: {C_T.shape}):\n", C_T, "\n")

# 4. Matrix Inverse (Where Valid)
G = B.T @ B
det_G = np.linalg.det(G)
print(f"4a. Square Gram Matrix G = B.T @ B (Shape: {G.shape}), Determinant = {det_G:.4f}")
if not np.isclose(det_G, 0):
    G_inv = np.linalg.inv(G)
    print("Inverse of G (G^-1):\n", G_inv)
    print("Verification (G @ G^-1 ≈ Identity):\n", np.round(G @ G_inv, 2), "\n")

# Pseudo-inverse for non-square matrix C (6x5 -> 5x6)
C_pinv = np.linalg.pinv(C)
print(f"4b. Moore-Penrose Pseudo-Inverse of C (Shape: {C_pinv.shape}):\n", C_pinv, "\n")

# 5. Element-wise Operations
C_normalized = C / 5.0                  # Element-wise division (scaling to 0-1)
C_squared = np.square(C)                # Element-wise squaring
hadamard_prod = C * C_normalized        # Element-wise multiplication (Hadamard product)

print("5. Element-wise Normalized C (C / 5.0):\n", C_normalized)
print("\nElement-wise Hadamard Product (C * C_normalized):\n", hadamard_prod, "\n")

# ==========================================
# Task 3: Compute Cosine Similarity
# ==========================================

# Compute L2 norms for each customer row vector (Shape: 6x1)
norms = np.linalg.norm(C, axis=1, keepdims=True)

# Normalize the customer vectors
C_unit = C / norms

# Compute the 6x6 Cosine Similarity Matrix
cos_sim_matrix = C_unit @ C_unit.T

print("6x6 Customer Cosine Similarity Matrix:\n", cos_sim_matrix, "\n")

# Identify the two most similar distinct customers (ignoring the diagonal of 1s)
sim_copy = cos_sim_matrix.copy()
np.fill_diagonal(sim_copy, -1)  # Mask self-similarity

# Find index of maximum similarity
max_idx = np.unravel_index(np.argmax(sim_copy), sim_copy.shape)
max_sim_score = sim_copy[max_idx]

c1, c2 = customers[max_idx[0]], customers[max_idx[1]]
print(f"Most Similar Customers: {c1} and {c2}")
print(f"Cosine Similarity Score: {max_sim_score:.4f}")
print(f"  {c1} ratings: {C[max_idx[0]]}")
print(f"  {c2} ratings: {C[max_idx[1]]}\n")

# ==========================================
# Task 4: Neural Network Dense Layer Pass
# ==========================================

# Select Customer 1 as input vector x (shape: 5,)
x = C[0]

# Weight matrix W is B.T (shape: 4x5 -> 4 books, 5 genres)
W = B.T

# Define a bias vector b for the 4 books (baseline popularity boost)
b = np.array([0.5, -0.2, 0.1, 0.3])

# 1. Manual computation using a loop (dot product per neuron + bias)
y_manual = np.zeros(len(books))
for i in range(len(books)):
    y_manual[i] = np.sum(W[i] * x) + b[i]

# 2. Vectorized NumPy Dense Layer equation: y = Wx + b
y_vectorized = np.dot(W, x) + b

# 3. Optional Activation Function (ReLU)
y_activated = np.maximum(0, y_vectorized)

print(f"Input Vector x (Cust_1):        {x}")
print(f"Weight Matrix W (B.T) shape:    {W.shape}")
print(f"Bias Vector b:                  {b}\n")
print(f"Manual Output (y = Wx + b):     {y_manual}")
print(f"Vectorized Output (y = Wx + b): {y_vectorized}")
print(f"ReLU Activated Output:          {y_activated}")
print(f"Outputs Match Exactly?          {np.allclose(y_manual, y_vectorized)}\n")

# ==========================================
# Task 5: Visualize Score Matrix as a Heatmap
# ==========================================

fig, axes = plt.subplots(1, 2, figsize=(14, 5))

# --- Plot 1: Customer-Book Score Matrix Heatmap ---
im1 = axes[0].imshow(S, cmap='YlGnBu', aspect='auto')
axes[0].set_title('Customer–Book Score Matrix ($S = C \\times B$)', fontsize=13, pad=12, fontweight='bold')
axes[0].set_xticks(np.arange(len(books)))
axes[0].set_yticks(np.arange(len(customers)))
axes[0].set_xticklabels(books, fontsize=11)
axes[0].set_yticklabels(customers, fontsize=11)
axes[0].set_xlabel('Books', fontsize=11)
axes[0].set_ylabel('Customers', fontsize=11)

# Annotate values inside each cell
for i in range(len(customers)):
    for j in range(len(books)):
        text_color = "white" if S[i, j] > (S.max() / 1.5) else "black"
        axes[0].text(j, i, f"{S[i, j]:.2f}", ha="center", va="center", color=text_color, fontweight='bold')

fig.colorbar(im1, ax=axes[0], label='Recommendation Score')

# --- Plot 2: Customer Cosine Similarity Heatmap ---
im2 = axes[1].imshow(cos_sim_matrix, cmap='coolwarm', vmin=0.4, vmax=1.0, aspect='auto')
axes[1].set_title('Customer Cosine Similarity Matrix', fontsize=13, pad=12, fontweight='bold')
axes[1].set_xticks(np.arange(len(customers)))
axes[1].set_yticks(np.arange(len(customers)))
axes[1].set_xticklabels(customers, fontsize=11)
axes[1].set_yticklabels(customers, fontsize=11)
axes[1].set_xlabel('Customers', fontsize=11)
axes[1].set_ylabel('Customers', fontsize=11)

# Annotate values inside each cell
for i in range(len(customers)):
    for j in range(len(customers)):
        text_color = "white" if cos_sim_matrix[i, j] > 0.85 else "black"
        axes[1].text(j, i, f"{cos_sim_matrix[i, j]:.2f}", ha="center", va="center", color=text_color, fontsize=9)

fig.colorbar(im2, ax=axes[1], label='Cosine Similarity')

plt.tight_layout()
plt.show()
